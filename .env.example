# Copy to .env.local (git-ignored) and fill in. Never commit real values.

# EXPO_PUBLIC_* values are bundled INTO the app: treat them as public.
# Laptop server on the same Wi-Fi: http://<your-laptop-LAN-IP>:3000
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
# Must match APP_TOKEN in server/.env (a speed bump, not real auth).
EXPO_PUBLIC_APP_TOKEN=change-me

# Only read at build time by app.config.ts. For EAS cloud builds, set it as an
# EAS environment variable instead of in this file.
GOOGLE_MAPS_ANDROID_API_KEY=
