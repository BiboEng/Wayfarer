# Copy to server/.env and fill in. server/.env is git-ignored; never commit real values.

# Port the server listens on.
PORT=3000
# Interface to bind. 0.0.0.0 lets a phone on the same LAN reach it.
HOST=0.0.0.0
# Shared app token the app sends in the x-wayfarer-token header (min 16 chars). A speed bump, not real auth.
APP_TOKEN=replace-with-a-long-random-string
# Max requests per IP per minute.
RATE_LIMIT_PER_MINUTE=60
# Number of reverse-proxy hops in front of the server (0 locally, 1 on Railway).
TRUST_PROXY=0
# Contact info for the User-Agent of Wikipedia/Overpass requests (email or repo URL).
# Wikimedia's API policy requires it. Put your real value only in server/.env; never commit it.
UPSTREAM_CONTACT=you@example.com
# Optional: SQLite file for the persistent cache (e.g. ./data/cache.sqlite). Unset = in-memory cache.
# CACHE_PATH=
# Overpass API endpoint.
OVERPASS_URL=https://overpass-api.de/api/interpreter


# --- Narration (AI text) ---
# OpenRouter key (https://openrouter.ai/keys). Use a key with a credit limit. Required.
OPENROUTER_API_KEY=replace-with-your-openrouter-key
# Which AI model writes the stories. Any OpenRouter model id works; this one is cheap
# (about $0.00024 per narration). Change it here, no code change needed.
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
# Daily limit on AI calls (UTC day). When reached, the server returns the plain Wikipedia intro instead.
DAILY_LLM_CALL_CAP=300
# Max narration requests per IP per minute (on top of RATE_LIMIT_PER_MINUTE).
NARRATION_RATE_LIMIT_PER_MINUTE=10

# --- Voice (audio) ---
# none = no server audio; the app speaks the text with the phone's own voice (free).
# elevenlabs = realistic voice, for demos.
TTS_PROVIDER=none
# Only needed when TTS_PROVIDER=elevenlabs.
# ELEVENLABS_API_KEY=replace-with-your-elevenlabs-key
# Voices to offer, as Label:voiceId pairs separated by commas. The first one is the default.
# ELEVENLABS_VOICES=Warm guide:replace-with-voice-id,Calm guide:replace-with-voice-id
# Daily limit on characters sent to the voice service (UTC day). When reached, the server returns text only.
DAILY_TTS_CHAR_CAP=5000
# Optional: folder for cached audio files (e.g. ./data/audio; /data/audio on Railway). Unset = kept in memory only.
# AUDIO_DIR=
